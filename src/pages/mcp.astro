---
import Layout from '../layouts/Layout.astro';
import { resolveActiveLang, LANGS } from '../lib/langs';

// GET /mcp renders this human-facing info page. MCP clients speak JSON-RPC over
// POST /mcp, which src/worker.ts routes to the backend handler; only GET/HEAD
// reaches Astro (see worker.ts). So a developer opening the endpoint in a
// browser gets localized guidance, while agents keep getting MCP responses.
const lang = resolveActiveLang(Astro.url.searchParams, Astro.request.headers.get('cookie'));

Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=0, s-maxage=300, stale-while-revalidate=600'
);

const MCP_ENDPOINT = new URL('/mcp', Astro.site).toString();

// Tool metadata mirrors worker/index.js tools/list (keep names in sync).
// Only the user-facing tools are listed. `format`/source params and the
// get_stats pipeline tool are internal-only and intentionally omitted here.
const TOOLS = [
  { name: 'search_releases', params: 'query · csp · lang · days · start_date · end_date · limit' },
  { name: 'get_release', params: 'id · lang' },
] as const;

type Strings = {
  title: string;
  description: string;
  tagline: string;
  subtitle: string;
  endpointLabel: string;
  copyLabel: string;
  copiedLabel: string;
  protocolLabel: string;
  toolsHeading: string;
  toolsIntro: string;
  toolDesc: Record<string, string>;
  setupHeading: string;
  setupIntro: string;
  langHeading: string;
  langIntro: string;
  langParamLabel: string;
  langValuesLabel: string;
  langValuesBody: string;
  langDefaultLabel: string;
  langDefaultBody: string;
  langFallbackLabel: string;
  langFallbackBody: string;
  siteCta: string;
  browserNote: string;
};

const UI: Record<string, Strings> = {
  ko: {
    title: "MCP 서버 안내 | What's New in Cloud",
    description: "What's New in Cloud의 MCP(Model Context Protocol) 엔드포인트 안내 — AWS·Google Cloud·Azure·Oracle Cloud 릴리스 노트를 AI 에이전트에서 검색하세요.",
    tagline: 'MCP',
    subtitle: 'AI 에이전트에서 클라우드 릴리스 노트를 바로 검색하세요',
    endpointLabel: 'MCP 엔드포인트',
    copyLabel: '복사',
    copiedLabel: '복사됨',
    protocolLabel: '프로토콜',
    toolsHeading: '제공 도구',
    toolsIntro: 'JSON-RPC 2.0 메서드 tools/call 로 호출할 수 있는 도구입니다.',
    toolDesc: {
      search_releases: '키워드·공급자(CSP)·기간으로 릴리스 노트를 검색합니다. aws/gcp/azure/oci는 한국어·영어 AI 요약을 제공합니다.',
      get_release: '기사 ID로 특정 릴리스 노트를 가져옵니다.',
    },
    setupHeading: 'MCP 클라이언트 설정',
    setupIntro: '사용하는 MCP 클라이언트(예: Claude Desktop, Cursor 등)의 설정에 아래 엔드포인트를 추가하세요.',
    langHeading: '언어 옵션 (lang)',
    langIntro: 'search_releases·get_release 도구는 lang 파라미터로 요약의 출력 언어를 지정합니다.',
    langParamLabel: '파라미터',
    langValuesLabel: '지원 값',
    langValuesBody: 'ko (한국어), en (영어). aws·gcp·azure·oci의 AI 요약에 적용됩니다.',
    langDefaultLabel: '기본값',
    langDefaultBody: '생략하면 ko(한국어)로 응답합니다.',
    langFallbackLabel: '폴백',
    langFallbackBody: '요청한 언어의 요약이 아직 없으면 영어 요약으로 대체되어 제공됩니다.',
    siteCta: '웹사이트로 돌아가기',
    browserNote: '이 페이지는 브라우저로 접속했을 때 보이는 안내입니다. MCP 클라이언트는 이 주소로 JSON-RPC(POST) 요청을 보내 응답을 받습니다.',
  },
  en: {
    title: "MCP Server | What's New in Cloud",
    description: "The What's New in Cloud MCP (Model Context Protocol) endpoint — search AWS, Google Cloud, Azure, and Oracle Cloud release notes from your AI agent.",
    tagline: 'MCP',
    subtitle: 'Search cloud release notes directly from your AI agent',
    endpointLabel: 'MCP endpoint',
    copyLabel: 'Copy',
    copiedLabel: 'Copied',
    protocolLabel: 'Protocol',
    toolsHeading: 'Available tools',
    toolsIntro: 'Tools you can invoke via the JSON-RPC 2.0 tools/call method.',
    toolDesc: {
      search_releases: 'Search release notes by keyword, cloud provider (CSP), or date range. aws/gcp/azure/oci provide Korean and English AI summaries.',
      get_release: 'Fetch a specific release note by article ID.',
      get_stats: 'Get the current translation / review pipeline status.',
    },
    setupHeading: 'MCP client setup',
    setupIntro: 'Add the endpoint below to your MCP client configuration (e.g. Claude Desktop, Cursor).',
    langHeading: 'Language option (lang)',
    langIntro: 'The search_releases and get_release tools take a lang parameter that sets the summary output language.',
    langParamLabel: 'Parameter',
    langValuesLabel: 'Values',
    langValuesBody: 'ko (Korean), en (English). Applies to the AI summaries for aws, gcp, azure, and oci.',
    langDefaultLabel: 'Default',
    langDefaultBody: 'If omitted, responses are returned in ko (Korean).',
    langFallbackLabel: 'Fallback',
    langFallbackBody: 'If a summary in the requested language is not available yet, the English summary is served instead.',
    siteCta: 'Back to the website',
    browserNote: 'This page is what you see in a browser. MCP clients send JSON-RPC (POST) requests to this same URL and receive machine responses.',
  },
  ja: {
    title: "MCPサーバー | What's New in Cloud",
    description: "What's New in Cloud の MCP（Model Context Protocol）エンドポイント — AWS・Google Cloud・Azure・Oracle Cloud のリリースノートを AI エージェントから検索できます。",
    tagline: 'MCP',
    subtitle: 'AIエージェントからクラウドのリリースノートを直接検索',
    endpointLabel: 'MCP エンドポイント',
    copyLabel: 'コピー',
    copiedLabel: 'コピーしました',
    protocolLabel: 'プロトコル',
    toolsHeading: '利用可能なツール',
    toolsIntro: 'JSON-RPC 2.0 の tools/call メソッドで呼び出せるツールです。',
    toolDesc: {
      search_releases: 'キーワード・クラウドプロバイダー（CSP）・期間でリリースノートを検索します。aws/gcp/azure/oci は日本語・英語の AI 要約を提供します。',
      get_release: '記事 ID で特定のリリースノートを取得します。',
      get_stats: '現在の翻訳・レビューパイプラインの状態を取得します。',
    },
    setupHeading: 'MCP クライアント設定',
    setupIntro: 'お使いの MCP クライアント（Claude Desktop、Cursor など）の設定に、以下のエンドポイントを追加してください。',
    langHeading: '言語オプション (lang)',
    langIntro: 'search_releases・get_release ツールは lang パラメータで要約の出力言語を指定します。',
    langParamLabel: 'パラメータ',
    langValuesLabel: '対応する値',
    langValuesBody: 'ko（韓国語）、en（英語）。aws・gcp・azure・oci の AI 要約に適用されます。',
    langDefaultLabel: 'デフォルト',
    langDefaultBody: '省略した場合は ko（韓国語）で応答します。',
    langFallbackLabel: 'フォールバック',
    langFallbackBody: 'リクエストした言語の要約がまだない場合は、英語の要約で代替して提供します。',
    siteCta: 'ウェブサイトに戻る',
    browserNote: 'このページはブラウザでアクセスしたときに表示される案内です。MCP クライアントはこの URL に JSON-RPC（POST）リクエストを送り、応答を受け取ります。',
  },
};

const t = UI[lang];

const configSnippet = JSON.stringify(
  { mcpServers: { 'whats-new-cloud': { url: MCP_ENDPOINT } } },
  null,
  2,
);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebAPI',
  name: "What's New in Cloud MCP",
  url: MCP_ENDPOINT,
  inLanguage: LANGS[lang].bcp47,
  description: t.description,
  documentation: MCP_ENDPOINT,
};
---

<Layout
  title={t.title}
  description={t.description}
  vendor="home"
  lang={lang}
  structuredData={structuredData}
>
  <!-- Hero: compact band. Keep the title at a readable size (home-like) but
       keep the band SHORT — small vertical padding so it doesn't eat space
       above the MCP guidance. Glow blobs are clipped and sit at the band's
       own edges so they never add height. -->
  <div class="hero-band relative text-center py-4 sm:py-5 mb-6 overflow-hidden rounded-2xl" style="background: linear-gradient(135deg, color-mix(in srgb, var(--color-primary) 5%, transparent), color-mix(in srgb, var(--color-accent) 5%, transparent)); border: 1px solid var(--color-border);">
    <div class="absolute top-0 left-0 w-28 h-28 -translate-x-1/3 -translate-y-1/3 rounded-full blur-3xl opacity-20" style="background: var(--color-primary);"></div>
    <div class="absolute bottom-0 right-0 w-28 h-28 translate-x-1/3 translate-y-1/3 rounded-full blur-3xl opacity-20" style="background: var(--color-accent);"></div>

    <h1 class="text-2xl sm:text-4xl font-black mb-1.5 tracking-tight" style="color: var(--color-text-primary); font-family: 'Pretendard Variable', var(--font-family);">
      ☁️ What's New <span class="bg-clip-text text-transparent bg-gradient-to-r" style="background-image: linear-gradient(to right, var(--color-primary), var(--color-accent));">in Cloud</span>
      <span class="text-xs font-semibold px-2 py-0.5 rounded-full ml-1" style="background: color-mix(in srgb, var(--color-primary) 15%, transparent); color: var(--color-primary); vertical-align: middle;">{t.tagline}</span>
    </h1>
    <p class="text-sm sm:text-base max-w-xl mx-auto leading-relaxed" style="color: var(--color-text-secondary); font-family: 'Pretendard Variable', var(--font-family);">
      <span class="font-medium">{t.subtitle}</span>
    </p>
  </div>

  <div class="max-w-3xl mx-auto space-y-6">
    <!-- Endpoint card -->
    <section class="p-5 sm:p-6 rounded-2xl" style="background: var(--color-surface); border: 1px solid var(--color-border); box-shadow: var(--card-shadow);">
      <div class="flex items-center justify-between gap-3 mb-3 flex-wrap">
        <h2 class="text-sm font-bold uppercase tracking-wide" style="color: var(--color-text-secondary);">{t.endpointLabel}</h2>
        <span class="text-xs font-medium px-2 py-0.5 rounded-full" style="background: color-mix(in srgb, var(--color-primary) 12%, transparent); color: var(--color-primary);">{t.protocolLabel}: JSON-RPC 2.0 · MCP 2024-11-05</span>
      </div>
      <div class="flex items-stretch gap-2">
        <code id="mcp-endpoint" class="flex-1 min-w-0 overflow-x-auto px-3 py-2.5 rounded-lg text-sm font-mono whitespace-nowrap" style="background: var(--color-bg); border: 1px solid var(--color-border); color: var(--color-text-primary);">{MCP_ENDPOINT}</code>
        <button id="copy-endpoint" type="button" data-copy={MCP_ENDPOINT} data-label-copy={t.copyLabel} data-label-copied={t.copiedLabel} class="shrink-0 px-3 py-2.5 rounded-lg text-sm font-semibold transition-colors hover:opacity-85" style="background: var(--color-primary); color: #fff;">{t.copyLabel}</button>
      </div>
      <p class="mt-3 text-xs leading-relaxed" style="color: var(--color-text-secondary);">{t.browserNote}</p>
    </section>

    <!-- Setup card -->
    <section class="p-5 sm:p-6 rounded-2xl" style="background: var(--color-surface); border: 1px solid var(--color-border); box-shadow: var(--card-shadow);">
      <h2 class="text-lg font-extrabold tracking-tight mb-1" style="color: var(--color-text-primary);">{t.setupHeading}</h2>
      <p class="text-sm leading-relaxed mb-3" style="color: var(--color-text-secondary);">{t.setupIntro}</p>
      <pre class="overflow-x-auto px-4 py-3 rounded-lg text-xs sm:text-sm font-mono leading-relaxed" style="background: var(--color-bg); border: 1px solid var(--color-border); color: var(--color-text-primary);"><code>{configSnippet}</code></pre>
    </section>

    <!-- Tools card -->
    <section class="p-5 sm:p-6 rounded-2xl" style="background: var(--color-surface); border: 1px solid var(--color-border); box-shadow: var(--card-shadow);">
      <h2 class="text-lg font-extrabold tracking-tight mb-1" style="color: var(--color-text-primary);">{t.toolsHeading}</h2>
      <p class="text-sm leading-relaxed mb-4" style="color: var(--color-text-secondary);">{t.toolsIntro}</p>
      <ul class="space-y-3">
        {TOOLS.map((tool) => (
          <li class="p-3.5 rounded-xl" style="background: var(--color-bg); border: 1px solid var(--color-border);">
            <div class="flex items-center gap-2 mb-1 flex-wrap">
              <code class="text-sm font-bold font-mono" style="color: var(--color-primary);">{tool.name}</code>
              <span class="text-[11px] font-mono" style="color: var(--color-text-secondary);">{tool.params}</span>
            </div>
            <p class="text-sm leading-relaxed" style="color: var(--color-text-primary);">{t.toolDesc[tool.name]}</p>
          </li>
        ))}
      </ul>
    </section>

    <!-- Language card -->
    <section class="p-5 sm:p-6 rounded-2xl" style="background: var(--color-surface); border: 1px solid var(--color-border); box-shadow: var(--card-shadow);">
      <h2 class="text-lg font-extrabold tracking-tight mb-1" style="color: var(--color-text-primary);">{t.langHeading}</h2>
      <p class="text-sm leading-relaxed mb-4" style="color: var(--color-text-secondary);">{t.langIntro}</p>
      <dl class="space-y-3">
        <div class="flex flex-col sm:flex-row sm:items-baseline gap-0.5 sm:gap-3">
          <dt class="shrink-0 w-28 text-xs font-bold uppercase tracking-wide" style="color: var(--color-text-secondary);">{t.langParamLabel}</dt>
          <dd class="text-sm leading-relaxed" style="color: var(--color-text-primary);"><code class="font-mono font-semibold" style="color: var(--color-primary);">lang</code></dd>
        </div>
        <div class="flex flex-col sm:flex-row sm:items-baseline gap-0.5 sm:gap-3">
          <dt class="shrink-0 w-28 text-xs font-bold uppercase tracking-wide" style="color: var(--color-text-secondary);">{t.langValuesLabel}</dt>
          <dd class="text-sm leading-relaxed" style="color: var(--color-text-primary);">{t.langValuesBody}</dd>
        </div>
        <div class="flex flex-col sm:flex-row sm:items-baseline gap-0.5 sm:gap-3">
          <dt class="shrink-0 w-28 text-xs font-bold uppercase tracking-wide" style="color: var(--color-text-secondary);">{t.langDefaultLabel}</dt>
          <dd class="text-sm leading-relaxed" style="color: var(--color-text-primary);">{t.langDefaultBody}</dd>
        </div>
        <div class="flex flex-col sm:flex-row sm:items-baseline gap-0.5 sm:gap-3">
          <dt class="shrink-0 w-28 text-xs font-bold uppercase tracking-wide" style="color: var(--color-text-secondary);">{t.langFallbackLabel}</dt>
          <dd class="text-sm leading-relaxed" style="color: var(--color-text-primary);">{t.langFallbackBody}</dd>
        </div>
      </dl>
    </section>

    <div class="text-center pt-2">
      <a href="/" class="inline-flex items-center gap-1.5 text-sm font-semibold transition-colors hover:opacity-80" style="color: var(--color-primary);">
        ← {t.siteCta}
      </a>
    </div>
  </div>

  <script>
    function initCopyEndpoint() {
      const btn = document.getElementById('copy-endpoint');
      if (!btn) return;
      btn.addEventListener('click', async () => {
        const value = btn.dataset.copy || '';
        const labelCopy = btn.dataset.labelCopy || 'Copy';
        const labelCopied = btn.dataset.labelCopied || 'Copied';
        try {
          await navigator.clipboard.writeText(value);
        } catch (e) {
          // Clipboard API is available on HTTPS (this page is always HTTPS);
          // if the user denied permission, just leave the value selectable.
          return;
        }
        btn.textContent = labelCopied;
        setTimeout(() => { btn.textContent = labelCopy; }, 1500);
      });
    }
    document.addEventListener('astro:page-load', initCopyEndpoint);
  </script>
</Layout>
