---
import Layout from '../layouts/Layout.astro';
import UpdateCard from '../components/UpdateCard.astro';
import { callBackend } from '../lib/apiClient';
import { PROVIDERS, isProvider } from '../lib/providers';
import { resolveActiveLang, LANGS } from '../lib/langs';

const { csp } = Astro.params;
if (!isProvider(csp)) return Astro.redirect('/');
const provider = PROVIDERS[csp];
const lang = resolveActiveLang(Astro.url.searchParams, Astro.request.headers.get('cookie'));

// Edge-cache the rendered HTML at Cloudflare. Content refreshes on a 1-min cron,
// so serve a 60s edge copy (cuts repeat TTFB) and keep serving stale for 5 min
// while revalidating in the background. Browsers always revalidate (max-age=0)
// so a user never sees stale beyond the edge window.
// Vary on the lang query so the edge doesn't serve one language's HTML for
// another; different ?lang= values are distinct cache keys already (URL-keyed),
// this just makes the intent explicit for shared caches.
Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=0, s-maxage=60, stale-while-revalidate=300'
);

let articles: any[] = [];
try {
  // Keep the last 30 days rather than a fixed count, so high-volume CSPs
  // (aws/gcp) still show a full month. limit is a safety ceiling.
  const res = await callBackend<{ items?: any[] }>(`/api/articles?csp=${csp}&lang=${lang}&days=30&limit=500`, { items: [] });
  articles = res.items || [];
} catch (e) { console.error(e); }

// Per-language UI strings and status vocabulary. Status values are stored in
// the target language (worker LANG_PROFILES), so the filter must match the
// language being shown. Each status maps to a stable class for styling.
const STATUS_BY_LANG: Record<string, { order: string[]; cls: Record<string, string> }> = {
  ko: { order: ['정식 출시', '미리보기', '베타', '지원 종료'], cls: { '정식 출시': 'ga', '미리보기': 'preview', '베타': 'beta', '지원 종료': 'retired' } },
  en: { order: ['General Availability', 'Preview', 'Beta', 'End of Support'], cls: { 'General Availability': 'ga', 'Preview': 'preview', 'Beta': 'beta', 'End of Support': 'retired' } },
  ja: { order: ['一般提供', 'プレビュー', 'ベータ', 'サポート終了'], cls: { '一般提供': 'ga', 'プレビュー': 'preview', 'ベータ': 'beta', 'サポート終了': 'retired' } },
};
const UI: Record<string, { updates: string; lastUpdated: string; search: string; shareFilter: string; linkCopied: string; openLabel: string; kv: { target: string; features: string; regions: string }; feedDesc: (name: string, url: string) => string; empty: string; noResults: string }> = {
  ko: { updates: '업데이트', lastUpdated: '최종 업데이트', search: '검색...', shareFilter: '현재 필터 링크 복사', linkCopied: '링크가 복사되었습니다', openLabel: '원문 보기', kv: { target: '대상', features: '기능', regions: '리전' }, feedDesc: (n, u) => `${n} <a href="${u}" target="_blank" rel="noopener noreferrer" class="underline font-semibold hover:opacity-80" style="color: var(--color-primary);">공식 RSS 피드</a>를 실시간 기계번역 및 품질 필터링을 통해 전달합니다.`, empty: '업데이트가 없습니다.', noResults: '검색 결과가 없습니다.' },
  en: { updates: 'Updates', lastUpdated: 'Last updated', search: 'Search...', shareFilter: 'Copy link to current filter', linkCopied: 'Link copied', openLabel: 'View original', kv: { target: 'Audience', features: 'Features', regions: 'Regions' }, feedDesc: (n, u) => `Machine-translated and quality-filtered from the <a href="${u}" target="_blank" rel="noopener noreferrer" class="underline font-semibold hover:opacity-80" style="color: var(--color-primary);">${n} official feed</a>.`, empty: 'No updates.', noResults: 'No results.' },
  ja: { updates: 'アップデート', lastUpdated: '最終更新', search: '検索...', shareFilter: '現在のフィルターのリンクをコピー', linkCopied: 'リンクをコピーしました', openLabel: '原文を見る', kv: { target: '対象', features: '機能', regions: 'リージョン' }, feedDesc: (n, u) => `<a href="${u}" target="_blank" rel="noopener noreferrer" class="underline font-semibold hover:opacity-80" style="color: var(--color-primary);">${n} 公式フィード</a>を機械翻訳および品質フィルタリングして提供します。`, empty: 'アップデートはありません。', noResults: '検索結果がありません。' },
};
const t = UI[lang];
const statusMeta = STATUS_BY_LANG[lang];
const STATUS_ORDER = statusMeta.order;

const rss = provider.official;
const names: Record<string, string> = { [csp]: provider.name };
const latest = articles[0]?.pub_date ? new Date(articles[0].pub_date).toLocaleString(LANGS[lang].bcp47, { year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' }) : '';

// Status counting (STATUS_ORDER is lang-aware, defined above)
const statusCounts: Record<string, number> = {};
for (const a of articles) {
  try {
    const ss = JSON.parse(a.status || '[]');
    const arr: string[] = Array.isArray(ss) ? ss : [];
    for (const s of arr) {
      if (STATUS_ORDER.includes(s)) statusCounts[s] = (statusCounts[s] || 0) + 1;
    }
  } catch { /* ignore */ }
}

function getArticleStatuses(a: any): string {
  try {
    const ss = JSON.parse(a.status || '[]');
    return Array.isArray(ss) ? ss.join(',') : '';
  } catch { return ''; }
}

const filterClass: Record<string, string> = { ...statusMeta.cls };
const activeStatusFilters = STATUS_ORDER.filter(s => (statusCounts[s] || 0) > 0);
const categoryUrl = new URL(`/${csp}`, Astro.site).toString();
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: `${names[csp]} 업데이트 | What's New in Cloud`,
    url: categoryUrl,
    inLanguage: LANGS[lang].bcp47,
    description: `${names[csp]} 공식 업데이트를 한국어로 요약한 최신 릴리스 노트 목록입니다.`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'What\'s New in Cloud',
        item: new URL('/', Astro.site).toString(),
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: names[csp],
        item: categoryUrl,
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: `${names[csp]} 최신 업데이트`,
    itemListElement: articles.slice(0, 10).map((a, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: a.title,
      url: a.url,
      datePublished: a.pub_date,
    })),
  },
];

---

<Layout
  title={`${names[csp]} ${t.updates} | What's New in Cloud`}
  description={`${names[csp]} 공식 업데이트를 빠르게 훑어볼 수 있도록 한국어로 정리한 최신 릴리스 노트 목록입니다.`}
  vendor={csp}
  lang={lang}
  ogImageAlt={`${names[csp]} 공식 업데이트를 요약한 What's New in Cloud 공유 이미지`}
  structuredData={structuredData}
>
  <div class="page-head">
    <div class="page-head__text">
      <h1 class="page-head__title">
        <span class="page-head__dot" aria-hidden="true"></span>
        <span class="page-head__title-text">{names[csp]} {t.updates}<span class="page-head__counter">({articles.length})</span></span>
      </h1>
      <p class="page-head__desc" set:html={t.feedDesc(names[csp], rss.url)}></p>
      {latest && <span class="page-head__meta">{t.lastUpdated}: {latest}</span>}
    </div>
    <div class="page-head__tools">
      {activeStatusFilters.length > 0 && (
        <div class="page-head__filters" id="filter-bar">
          {activeStatusFilters.map(s => (
            <button
              class={`filter-btn filter-btn--${filterClass[s]}`}
              type="button"
              aria-pressed="false"
              data-filter={s}>
              {s}<span class="count">{statusCounts[s]}</span>
            </button>
          ))}
        </div>
      )}
      <div class="page-head__search search">
        <svg class="search__icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
        <input type="search" id="search" placeholder={t.search} aria-label={t.search} autocomplete="off" class="search__input" />
      </div>
      <button type="button" id="share-filter" class="share-filter-btn" data-copied-label={t.linkCopied} aria-label={t.shareFilter} title={t.shareFilter}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.59 13.51l6.83 3.98M15.41 6.51l-6.82 3.98M18 8a3 3 0 10-3-3 3 3 0 003 3zM6 15a3 3 0 10-3-3 3 3 0 003 3zm12 7a3 3 0 10-3-3 3 3 0 003 3z"></path>
        </svg>
      </button>
    </div>
  </div>

  <div class="cards-grid" id="cards">
    {articles.map((a, i) => (
      <div class="card-wrapper" data-statuses={getArticleStatuses(a)}>
        <UpdateCard
          title={a.title} csp={a.csp} index={i}
          date={a.pub_date ? new Date(a.pub_date).toLocaleDateString(LANGS[lang].bcp47, { year: 'numeric', month: 'short', day: 'numeric' }) : ''}
          content={a.summary || ''} target={a.target} features={a.features}
          regions={a.regions} status={a.status} originalLink={a.url} articleId={a.article_id} openLabel={t.openLabel} kvLabels={t.kv} />
      </div>
    ))}
  </div>

  {articles.length === 0 && (
    <p class="text-center py-16 text-sm" style="color: var(--color-text-secondary);">{t.empty}</p>
  )}

  <p id="no-results" class="hidden text-center py-16 text-sm" style="color: var(--color-text-secondary);">{t.noResults}</p>

  <script>
    // Bind search and filtering on page load/navigation.
    // URL params (?status=, ?q=) are READ on load to restore a shared/bookmarked
    // view, but clicking a chip or typing does NOT rewrite the URL — that would
    // churn history and feel like a refresh. The explicit "필터 링크 복사" button
    // is the only thing that serializes the current filter state to a URL.
    function initSearchFilters() {
      const searchEl = document.getElementById('search') as HTMLInputElement;
      const wrappers = Array.from(document.querySelectorAll<HTMLElement>('#cards > .card-wrapper'));
      const noResults = document.getElementById('no-results') as HTMLElement;
      let activeFilter = '';

      function applyFilters() {
        const q = (searchEl?.value || '').toLowerCase();
        let visible = 0;
        wrappers.forEach(wrapper => {
          const matchSearch = !q || (wrapper.textContent?.toLowerCase() || '').includes(q);
          const matchFilter = !activeFilter || (wrapper.dataset.statuses || '').includes(activeFilter);
          const show = matchSearch && matchFilter;
          wrapper.style.display = show ? '' : 'none';
          if (show) visible++;
        });
        if (noResults) noResults.classList.toggle('hidden', visible > 0);
      }

      function reflectActiveChip() {
        document.querySelectorAll<HTMLElement>('.filter-btn').forEach(b => {
          const on = b.dataset.filter === activeFilter && activeFilter !== '';
          b.classList.toggle('is-active', on);
          b.setAttribute('aria-pressed', on ? 'true' : 'false');
        });
      }

      // Restore state from the URL on load (shared/bookmarked link). Only accept
      // a status that actually exists as a chip on this page.
      const params = new URLSearchParams(window.location.search);
      const urlStatus = params.get('status') || '';
      const urlQuery = params.get('q') || '';
      const validStatuses = Array.from(document.querySelectorAll<HTMLElement>('.filter-btn'))
        .map(b => b.dataset.filter || '');
      if (urlStatus && validStatuses.includes(urlStatus)) activeFilter = urlStatus;
      if (urlQuery && searchEl) searchEl.value = urlQuery;
      reflectActiveChip();
      applyFilters();

      searchEl?.addEventListener('input', applyFilters);

      document.querySelectorAll<HTMLElement>('.filter-btn').forEach(btn => {
        btn.onclick = () => {
          const f = btn.dataset.filter || '';
          activeFilter = activeFilter === f ? '' : f;
          reflectActiveChip();
          applyFilters();
          // Intentionally NO URL update here (avoids refresh-like history churn).
        };
      });

      // Share button: serialize the CURRENT filter + search to a URL and copy it.
      const shareBtn = document.getElementById('share-filter');
      const shareLabel = shareBtn?.getAttribute('aria-label') || '';
      const copiedLabel = shareBtn?.getAttribute('data-copied-label') || shareLabel;
      let shareResetTimer: ReturnType<typeof setTimeout> | undefined;
      shareBtn?.addEventListener('click', async () => {
        const u = new URL(window.location.href);
        u.hash = '';
        u.searchParams.delete('status');
        u.searchParams.delete('q');
        if (activeFilter) u.searchParams.set('status', activeFilter);
        const q = (searchEl?.value || '').trim();
        if (q) u.searchParams.set('q', q);
        const link = u.toString();
        try {
          await navigator.clipboard.writeText(link);
          shareBtn.classList.add('copied');
          shareBtn.setAttribute('aria-label', copiedLabel);
          clearTimeout(shareResetTimer);
          shareResetTimer = setTimeout(() => {
            shareBtn.classList.remove('copied');
            shareBtn.setAttribute('aria-label', shareLabel);  // always the original
          }, 1500);
        } catch { /* clipboard blocked; no-op */ }
      });
    }

    document.addEventListener('astro:page-load', initSearchFilters);
  </script>

</Layout>

<script>
  // Pulse on arrival + persistent card-active (hover-like) state
  function initCardActiveState() {
    let activeCard: HTMLElement | null = null;

    function expandTarget() {
      const rawHash = window.location.hash;
      if (!rawHash) return;
      // IDs are now the bare numeric article id (#5370584). Old shared links
      // used #article-5370584 — strip the legacy prefix for back-compat.
      const id = rawHash.slice(1).replace(/^article-/, '');
      if (!id) return;

      // Deactivate previous
      if (activeCard) activeCard.classList.remove('card-active');

      // getElementById (not querySelector) so a numeric id is a valid lookup.
      const card = document.getElementById(id);
      if (!card) return;
      activeCard = card;

      // Persist hover-like state
      card.classList.add('card-active');

      // Amber pulse for initial attention
      card.classList.remove('card-pulse');
      void card.offsetWidth;
      card.classList.add('card-pulse');

      setTimeout(() => card.scrollIntoView({ behavior: 'smooth', block: 'center' }), 100);
    }

    // Click outside to dismiss active state
    document.onclick = (e) => {
      if (activeCard && !activeCard.contains(e.target as Node)) {
        activeCard.classList.remove('card-active');
        activeCard = null;
      }
    };

    expandTarget();
    window.onhashchange = expandTarget;
  }

  document.addEventListener('astro:page-load', initCardActiveState);
</script>
